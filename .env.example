# "dev" ou "production" — en production, le démarrage échoue si SECRET_KEY n'est pas définie
APP_ENV=dev

# ── Base de données ──
# En local (défaut) : SQLite
DATABASE_URL=sqlite:///./data/menu.db
# Base MySQL Hostinger (créée dans hPanel → Bases de données), depuis le même serveur :
# DATABASE_URL=mysql+pymysql://u123456789_menus:MOT_DE_PASSE@127.0.0.1:3306/u123456789_menus?charset=utf8mb4
# Depuis un VPS vers le MySQL d'un hébergement mutualisé Hostinger (Remote MySQL activé) :
# DATABASE_URL=mysql+pymysql://u123456789_menus:MOT_DE_PASSE@srvXXXX.hstgr.io:3306/u123456789_menus?charset=utf8mb4

PORT=8000
SECRET_KEY=changez-moi-en-production-avec-une-cle-secrete-longue

# Freemium : nombre d'imports de recettes gratuits par mois et par membre
IMPORT_FREE_LIMIT=3

# Espace admin : si défini, seul ce compte email y a accès (sinon, le propriétaire du foyer)
SUPER_ADMIN_EMAIL=

# Emails rattachés au foyer d'origine (base de recettes complète) — séparés par des virgules.
# Tout autre inscrit sans code d'invitation démarre un foyer vide.
FULL_BASE_EMAILS=

# OAuth Google (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiements Stripe (abonnement Premium). Laisser vide pour désactiver le paiement.
# Clés dans Stripe → Développeurs → Clés API. Price IDs dans Catalogue de produits.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
